    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.LLM_BASE_URL.replace(/\\/+$/, '') }}/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Настройки').first().json.LLM_MODEL, temperature: 0.2, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          },
          "timeout": 60000
        }
      },
      "id": "5b7e9a10-0007-4d2a-9c01-000000000007",
      "name": "Нейросеть",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Совместимый с OpenAI интерфейс. Ключ в учётных данных OpenAI, запросы по одному раз в 3 секунды."
    },
    {
      "parameters": {
