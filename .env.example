# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Для docker compose
# Длинная случайная строка, например: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Moscow

# Для настройки конвейера. В контейнер не передаются: ключи вводятся в учётные
# данные n8n, остальное в узел «Настройки» (docs/setup.md).

# Нейросеть через совместимый с OpenAI интерфейс (по умолчанию Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# Телеграм: бот, который присылает подборку, и чат, куда её присылать
TELEGRAM_BOT_TOKEN=
CHAT_ID=

# Журнал SQLite внутри тома n8n
JR_DB_PATH=/home/node/.n8n/job-radar.sqlite
